// Kenzed Tech Lab — database schema.
// The connection URL lives in prisma.config.ts, sourced from DATABASE_URL in .env.
//
//   npx prisma migrate dev     apply schema changes locally
//   npx prisma studio          browse the data in a GUI

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// A contact-form submission from the website.
model Lead {
  id      Int    @id @default(autoincrement())
  name    String @db.VarChar(120)
  email   String @db.VarChar(190)
  company String? @db.VarChar(160)

  /// Which service the enquiry is about (see src/content/services.ts).
  service String  @db.VarChar(140)
  budget  String? @db.VarChar(60)
  message String  @db.Text

  status LeadStatus @default(NEW)

  /// Page the form was submitted from, for attribution.
  sourcePath String? @db.VarChar(255)
  userAgent  String? @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
  @@map("leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  ARCHIVED
}
